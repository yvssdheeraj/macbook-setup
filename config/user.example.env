# User Configuration Example
# Copy this file to user.env and configure it.
# DO NOT commit user.env to version control!

# Git Configuration
GIT_USER_NAME="Your Name"
GIT_USER_EMAIL="your.email@example.com"
GIT_DEFAULT_BRANCH="main"
GIT_EDITOR="nano" # or vim, code --wait, etc.

# Development Tool Versions
NODE_VERSION="lts/*"
PYTHON_VERSION="3.12"
JAVA_VERSION="17.0.9-tem"
GRADLE_VERSION="8.5"

# IntelliJ IDEA Edition
# Options: 'idea-community' or 'idea-ultimate'
INTELLIJ_EDITION="idea-community"

# Docker & Colima Options
COLIMA_CPU="2"
COLIMA_MEMORY="4"
COLIMA_DISK="50"

# Optional: AWS Profile defaults
AWS_DEFAULT_REGION="us-east-1"
AWS_PROFILE="default"
