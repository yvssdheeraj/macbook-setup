# Copy to user.env. This is data, not executable shell: no expansion or commands.
# Environment overrides this file; CLI selection/mode overrides both.

GIT_USER_NAME=""
GIT_USER_EMAIL=""
GIT_DEFAULT_BRANCH="main"
GIT_EDITOR="nano"

# Channels resolve stable releases at installation/update time, not on every rerun.
NODE_VERSION="lts/*"
PYTHON_VERSION="stable"
JAVA_VERSION="lts"
JAVA_LTS="latest" # Or a supported LTS major, for example "21".
GRADLE_VERSION="stable" # Projects should use their own Gradle Wrapper.

# Current IntelliJ uses a unified application; paid features need a license.
INTELLIJ_EDITION="idea-community"

COLIMA_CPU="2"
COLIMA_MEMORY="4"
COLIMA_DISK="50"
COLIMA_START_AT_LOGIN="false"

# Optional shell defaults; existing ~/.aws/config and credentials are preserved.
AWS_DEFAULT_REGION=""
AWS_PROFILE="default"

# Optional absolute paths must remain under HOME. Unset defaults:
# BREW_PREFIX: ~/.homebrew (Tier 3; source builds may be necessary)
# APP_DIR: ~/Applications
# LOCAL_BIN: ~/.local/bin
# DATA_DIR: ~/.local/share/macbook-setup
# STATE_DIR: ~/Library/Application Support/macbook-setup
# CACHE_DIR: ~/Library/Caches/macbook-setup
